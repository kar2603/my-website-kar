# ================================================================
# KAR HOBBY - ENVIRONMENT TEMPLATE (.env.example)
# Đổi tên file này thành .env trên VPS và điền thông tin thực tế
# ================================================================

# Resend Email API Key & Sender Configuration
# Lấy API Key tại: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_SENDER=KAR HOBBY <contact@yourdomain.com>
ADMIN_EMAIL=admin@yourdomain.com
DOMAIN=yourdomain.com

# Database Configuration
DATABASE_PATH=brain.db

# SePay VietQR Auto-Sync Sheet URL (CSV Format)
SEPAY_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/your_sheet_id_here/export?format=csv

# Server Port (Mặc định 3000 hoặc tùy chỉnh)
PORT=3000
